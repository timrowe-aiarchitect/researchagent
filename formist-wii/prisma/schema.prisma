// Website Intelligence Index (WII) — Prisma schema
// Mirrors the data model defined in docs/PRD-website-intelligence-index-mvp.md

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DetectedCms {
  wordpress
  other
  unknown
}

enum ScanStatus {
  queued
  crawling
  scoring
  complete
  failed
}

enum CrawlStatus {
  success
  timeout
  blocked_by_robots
  error
  redirect
}

enum EvidenceCategory {
  technical_seo
  on_page_seo
  ai_discoverability
  performance
  accessibility
  security
  analytics
  wordpress_maintainability
  brand_experience
  conversion
}

enum Severity {
  info
  minor
  moderate
  major
  critical
}

enum CategoryStatus {
  good
  needs_attention
  poor
  critical
}

enum ReportStatus {
  draft
  needs_review
  approved
  exported
}

model Client {
  id             String      @id @default(cuid())
  name           String?
  /// Free-text industry/vertical, supplied at scan-request time — used as context for the LLM
  /// qualitative assessment (lib/qualitative-assessment.ts). Optional; never required to scan.
  industry       String?
  /// Free-text primary conversion goal (e.g. "book a consultation"), same purpose as industry.
  conversionGoal String?     @map("conversion_goal")
  rootUrl        String      @unique @map("root_url")
  detectedCms    DetectedCms @default(unknown) @map("detected_cms")
  createdAt      DateTime    @default(now()) @map("created_at")

  scans Scan[]

  @@map("clients")
}

model Scan {
  id             String     @id @default(cuid())
  clientId       String     @map("client_id")
  client         Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedBy    String     @map("requested_by")
  status         ScanStatus @default(queued)
  startedAt      DateTime?  @map("started_at")
  completedAt    DateTime?  @map("completed_at")
  pagesRequested Int        @default(25) @map("pages_requested")
  pagesCrawled   Int        @default(0) @map("pages_crawled_count")
  failureReason  String?    @map("failure_reason")
  createdAt      DateTime   @default(now()) @map("created_at")

  pages           Page[]
  evidenceItems   EvidenceItem[]
  categoryScores  CategoryScore[]
  recommendations Recommendation[]
  report          Report?

  @@index([clientId])
  @@index([status])
  @@map("scans")
}

model Page {
  id          String      @id @default(cuid())
  scanId      String      @map("scan_id")
  scan        Scan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  url         String
  httpStatus  Int?        @map("http_status")
  crawlStatus CrawlStatus @map("crawl_status")
  finalUrl    String?     @map("final_url")
  rendered    Boolean     @default(false)
  fetchedAt   DateTime    @default(now()) @map("fetched_at")

  title            String?
  metaDescription  String?  @map("meta_description")
  canonical        String?
  h1               String?
  h2               String[]
  wordCount        Int?     @map("word_count")
  internalLinks    String[] @map("internal_links")
  externalLinks    String[] @map("external_links")
  images           Json?
  forms            Json?
  buttons          String[]
  jsonLd           Json?    @map("json_ld")
  openGraph        Json?    @map("open_graph")
  scripts          Json?
  screenshotPath   String?  @map("screenshot_path")

  @@index([scanId])
  @@map("pages")
}

model EvidenceItem {
  id         String           @id @default(cuid())
  scanId     String           @map("scan_id")
  scan       Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  category   EvidenceCategory
  source     String
  severity   Severity
  finding    String
  url        String?
  rawData    Json?            @map("raw_data")
  confidence Float            @default(1)
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([scanId, category])
  @@map("evidence_items")
}

model CategoryScore {
  id           String           @id @default(cuid())
  scanId       String           @map("scan_id")
  scan         Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  category     EvidenceCategory
  // Automated fields — written once by the scoring engine (lib/scoring.ts) and never mutated
  // afterward. The human review workflow (lib/report-review.ts) only ever writes the override_*
  // columns below, so the automated result is always recoverable even after a reviewer edits it.
  score        Float
  maxScore     Float            @default(100) @map("max_score")
  status       CategoryStatus
  rationale    String
  confidence   Float            @default(1)
  evidenceRefs Json             @map("evidence_refs")
  createdAt    DateTime         @default(now()) @map("created_at")

  /// Reviewer-supplied score override (see PATCH /api/reports/[id]/categories/[category]).
  /// Effective/displayed score is overrideScore ?? score; status is re-derived from that ratio,
  /// never independently overridden. Null when this category hasn't been reviewed/overridden.
  overrideScore     Float?    @map("override_score")
  /// Reviewer-edited rationale text. Independent of overrideScore — a reviewer may reword the
  /// rationale without changing the score, or vice versa.
  overrideRationale String?   @map("override_rationale")
  /// Required whenever overrideScore is set to a new (non-null) value; optional when only the
  /// rationale is edited or when clearing an existing override back to the automated score.
  overrideNote      String?   @map("override_note")
  overriddenBy      String?   @map("overridden_by")
  overriddenAt      DateTime? @map("overridden_at")

  @@unique([scanId, category])
  @@map("category_scores")
}

model Recommendation {
  id           String           @id @default(cuid())
  scanId       String           @map("scan_id")
  scan         Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  priorityRank Int              @map("priority_rank")
  title        String
  category     EvidenceCategory
  impact       String
  effort       String
  recommendation String
  evidenceRefs Json             @map("evidence_refs")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([scanId])
  @@map("recommendations")
}

model Report {
  id                     String   @id @default(cuid())
  scanId                 String   @unique @map("scan_id")
  scan                   Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  executiveSummary       String   @map("executive_summary")
  fullReport             Json     @map("full_report")
  /// LLM-generated qualitative narrative (brand clarity, UX, conversion, trust, AI discoverability)
  /// — additive only. Never read by lib/scoring.ts and never influences any deterministic score;
  /// null whenever the assessment wasn't generated (no API key configured, or the call failed).
  qualitativeAssessment  Json?    @map("qualitative_assessment")
  html                   String
  pdfUrl                 String?  @map("pdf_url")
  generatedAt            DateTime @default(now()) @map("generated_at")

  /// Human review workflow (see lib/report-review.ts). A report starts as draft the moment the
  /// scan completes; reviewedBy/reviewedAt track whoever last changed the status (no auth system
  /// exists yet, so this is free text like Scan.requestedBy).
  status     ReportStatus @default(draft)
  reviewedBy String?      @map("reviewed_by")
  reviewedAt DateTime?    @map("reviewed_at")

  @@map("reports")
}
