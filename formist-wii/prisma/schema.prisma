// Website Intelligence Index (WII) — Prisma schema
// Mirrors the data model defined in docs/PRD-website-intelligence-index-mvp.md

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DetectedCms {
  wordpress
  other
  unknown
}

enum ScanStatus {
  queued
  crawling
  scoring
  complete
  failed
}

enum CrawlStatus {
  success
  timeout
  blocked_by_robots
  error
  redirect
}

enum EvidenceCategory {
  technical_seo
  on_page_seo
  ai_discoverability
  performance
  accessibility
  security
  analytics
  wordpress_maintainability
  brand_experience
  conversion
}

enum Severity {
  info
  minor
  moderate
  major
  critical
}

enum CategoryStatus {
  good
  needs_attention
  poor
  critical
}

model Client {
  id          String      @id @default(cuid())
  name        String?
  rootUrl     String      @unique @map("root_url")
  detectedCms DetectedCms @default(unknown) @map("detected_cms")
  createdAt   DateTime    @default(now()) @map("created_at")

  scans Scan[]

  @@map("clients")
}

model Scan {
  id             String     @id @default(cuid())
  clientId       String     @map("client_id")
  client         Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedBy    String     @map("requested_by")
  status         ScanStatus @default(queued)
  startedAt      DateTime?  @map("started_at")
  completedAt    DateTime?  @map("completed_at")
  pagesRequested Int        @default(25) @map("pages_requested")
  pagesCrawled   Int        @default(0) @map("pages_crawled_count")
  failureReason  String?    @map("failure_reason")
  createdAt      DateTime   @default(now()) @map("created_at")

  pages           Page[]
  evidenceItems   EvidenceItem[]
  categoryScores  CategoryScore[]
  recommendations Recommendation[]
  report          Report?

  @@index([clientId])
  @@index([status])
  @@map("scans")
}

model Page {
  id          String      @id @default(cuid())
  scanId      String      @map("scan_id")
  scan        Scan        @relation(fields: [scanId], references: [id], onDelete: Cascade)
  url         String
  httpStatus  Int?        @map("http_status")
  crawlStatus CrawlStatus @map("crawl_status")
  finalUrl    String?     @map("final_url")
  rendered    Boolean     @default(false)
  fetchedAt   DateTime    @default(now()) @map("fetched_at")

  title            String?
  metaDescription  String?  @map("meta_description")
  canonical        String?
  h1               String?
  h2               String[]
  wordCount        Int?     @map("word_count")
  internalLinks    String[] @map("internal_links")
  externalLinks    String[] @map("external_links")
  images           Json?
  forms            Json?
  buttons          String[]
  jsonLd           Json?    @map("json_ld")
  openGraph        Json?    @map("open_graph")
  scripts          Json?
  screenshotPath   String?  @map("screenshot_path")

  @@index([scanId])
  @@map("pages")
}

model EvidenceItem {
  id         String           @id @default(cuid())
  scanId     String           @map("scan_id")
  scan       Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  category   EvidenceCategory
  source     String
  severity   Severity
  finding    String
  url        String?
  rawData    Json?            @map("raw_data")
  confidence Float            @default(1)
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([scanId, category])
  @@map("evidence_items")
}

model CategoryScore {
  id           String           @id @default(cuid())
  scanId       String           @map("scan_id")
  scan         Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  category     EvidenceCategory
  score        Float
  maxScore     Float            @default(100) @map("max_score")
  status       CategoryStatus
  rationale    String
  confidence   Float            @default(1)
  evidenceRefs Json             @map("evidence_refs")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@unique([scanId, category])
  @@map("category_scores")
}

model Recommendation {
  id           String           @id @default(cuid())
  scanId       String           @map("scan_id")
  scan         Scan             @relation(fields: [scanId], references: [id], onDelete: Cascade)
  priorityRank Int              @map("priority_rank")
  title        String
  category     EvidenceCategory
  impact       String
  effort       String
  recommendation String
  evidenceRefs Json             @map("evidence_refs")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([scanId])
  @@map("recommendations")
}

model Report {
  id                     String   @id @default(cuid())
  scanId                 String   @unique @map("scan_id")
  scan                   Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  executiveSummary       String   @map("executive_summary")
  fullReport             Json     @map("full_report")
  /// LLM-generated qualitative narrative (brand clarity, UX, conversion, trust, AI discoverability)
  /// — additive only. Never read by lib/scoring.ts and never influences any deterministic score;
  /// null whenever the assessment wasn't generated (no API key configured, or the call failed).
  qualitativeAssessment  Json?    @map("qualitative_assessment")
  html                   String
  pdfUrl                 String?  @map("pdf_url")
  generatedAt            DateTime @default(now()) @map("generated_at")

  @@map("reports")
}
