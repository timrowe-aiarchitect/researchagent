DATABASE_URL="postgresql://formist:formist@127.0.0.1:5432/formist_wii?schema=public"
REDIS_URL="redis://127.0.0.1:6379"

# Optional: only needed if your installed `playwright` package version doesn't match the
# Chromium build already present on this machine (e.g. a pinned browser cache in CI/sandboxes).
# Leave unset to let Playwright resolve its own bundled browser normally.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# Optional: Google PageSpeed Insights API key. Without it, PSI calls are subject to a very low
# shared quota and extractPerformance.ts's Lighthouse/Core Web Vitals checks will gracefully
# report "analysis unavailable" once that quota is exhausted. Get a key at
# https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=
